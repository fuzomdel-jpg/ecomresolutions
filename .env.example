# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecomresolutions?schema=public"

# Auth.js / NextAuth
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"
# Production: both URL values must be the public HTTPS origin, e.g. https://ecomresolutions.com

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI
OPENAI_API_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Object storage (S3-compatible). Leave empty to use local disk storage.
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION="us-east-1"

# Transactional email (Resend-compatible). Leave empty to log emails in development.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="Ecom Resolutions <noreply@ecomresolutions.com>"

# Optional n8n webhook signing
N8N_WEBHOOK_SECRET=""
N8N_OUTBOUND_WEBHOOK_URL=""

# Seeded admin (never commit real credentials)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_EXPERT_EMAIL=""
SEED_EXPERT_PASSWORD=""
